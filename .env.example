# ==============================================================================
# 지식재산처_KIPRIS_지식재산정보 검색서비스 환경 설정 파일 (.env)
# ==============================================================================
# 공공데이터포털(data.go.kr) 또는 KIPRISPlus(plus.kipris.or.kr)에서 발급받은
# 특허청 상표/디자인 검색 Open API 서비스 키를 입력하세요.
# 키가 아직 없거나 신청 중인 경우, KIPRIS_USE_MOCK=true 로 두시면
# 모의 데이터(Mock Data)로 대시보드의 모든 기능을 즉시 테스트하실 수 있습니다.
# ==============================================================================

# KIPRIS / 공공데이터포털 일반 인증키 (Service Key)
KIPRIS_API_KEY=your_kipris_api_key_here

# 모의 데이터(시뮬레이션) 사용 여부 (true: 샘플 데이터 사용, false: 실제 KIPRIS API 호출)
KIPRIS_USE_MOCK=true

# 서버 포트 설정
PORT=8000

